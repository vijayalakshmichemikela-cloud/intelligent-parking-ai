# Smart Parking Management System Configuration
# Copy this file to .env and adjust variables as required

# Flask Secret Key for session security
SECRET_KEY=super-secret-smart-parking-key-2026-change-in-production

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration
# Primary: 'mysql' using mysql-connector-python
# Fallback / Testing: 'sqlite' (automatically creates local smart_parking.db if MySQL is offline)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_parking_db

# Application Timezone
APP_TIMEZONE=UTC
